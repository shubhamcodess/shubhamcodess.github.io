{
  "name": "@portfolio/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5180",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 5181",
    "typecheck": "tsc --noEmit",
    "data": "node --experimental-strip-types --no-warnings scripts/fetch-credentials.mjs && node scripts/fetch-previews.mjs && node scripts/fetch-writing.mjs",
    "previews": "node scripts/fetch-previews.mjs && node scripts/fetch-writing.mjs",
    "photos": "node scripts/add-photos.mjs",
    "format": "prettier --write src scripts vite.config.ts",
    "social-image": "node scripts/social-image.mjs",
    "app-icons": "node scripts/app-icons.mjs",
    "grain": "node scripts/grain.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "gray-matter": "4.0.3",
    "marked": "15.0.12",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
