{
  "name": "shubham-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --filter @portfolio/web build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tests",
    "test": "vitest run",
    "icons": "node --experimental-strip-types --no-warnings scripts/build-icons.mjs",
    "budget": "node scripts/check-budget.mjs",
    "phone": "node scripts/check-phone.mjs",
    "responsive": "node scripts/check-responsive.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm budget && pnpm responsive"
  },
  "devDependencies": {
    "@portfolio/content": "workspace:*",
    "@portfolio/design": "workspace:*",
    "@portfolio/site": "workspace:*",
    "@portfolio/stats": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
