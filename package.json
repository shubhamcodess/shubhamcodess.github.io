{
  "name": "shubham-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/app dev",
    "build": "pnpm --filter @portfolio/app build",
    "preview": "pnpm --filter @portfolio/app preview",
    "check": "pnpm --filter @portfolio/app typecheck && pnpm --filter @portfolio/app build",
    "data": "pnpm --filter @portfolio/app data",
    "web:dev": "pnpm --filter @portfolio/web dev",
    "web:build": "pnpm --filter @portfolio/web build",
    "web:typecheck": "pnpm -r --filter '!@portfolio/app' --if-present typecheck && tsc --noEmit -p tests",
    "web:test": "vitest run",
    "web:icons": "node --experimental-strip-types --no-warnings scripts/build-icons.mjs",
    "web:budget": "node scripts/check-budget.mjs",
    "web:phone": "node scripts/check-phone.mjs",
    "web:responsive": "node scripts/check-responsive.mjs",
    "web:perf": "node scripts/check-perf.mjs",
    "web:check": "pnpm web:typecheck && pnpm web:test && pnpm web:build && pnpm web:budget && pnpm web:responsive && pnpm web:perf"
  },
  "devDependencies": {
    "@portfolio/content": "workspace:*",
    "@portfolio/design": "workspace:*",
    "@portfolio/site": "workspace:*",
    "@portfolio/stats": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
